    <script>
        (function () {
            var cartKey = 'skadoosh.cart';
            var favoriteKey = 'skadoosh.favorites';
            var body = document.body;
            var isAuthenticated = body.dataset.authenticated === '1';
            var backdrop = document.querySelector('[data-panel-backdrop]');
            var loginModal = document.querySelector('[data-login-modal]');

            function read(key) {
                try { return JSON.parse(localStorage.getItem(key) || '[]'); } catch (e) { return []; }
            }

            function write(key, value) {
                localStorage.setItem(key, JSON.stringify(value));
            }

            function formatPeso(value) {
                return '₱' + Number(value || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function closePanels() {
                document.querySelectorAll('[data-panel]').forEach(function (panel) { panel.classList.remove('is-open'); });
                if (backdrop) backdrop.classList.remove('is-open');
            }

            function openPanel(name) {
                closeLoginModal();
                document.querySelectorAll('[data-panel]').forEach(function (panel) {
                    panel.classList.toggle('is-open', panel.dataset.panel === name);
                });
                if (backdrop) backdrop.classList.add('is-open');
                if (name === 'favorites') renderFavorites();
            }

            function openLoginModal() {
                closePanels();
                if (backdrop) backdrop.classList.add('is-open');
                if (loginModal) loginModal.classList.add('is-open');
            }

            function closeLoginModal() {
                if (loginModal) loginModal.classList.remove('is-open');
            }

            function updateCounts() {
                var cart = read(cartKey);
                var favorites = read(favoriteKey);
                var cartCount = cart.reduce(function (sum, item) { return sum + Number(item.quantity || 1); }, 0);
                document.querySelectorAll('[data-cart-count]').forEach(function (badge) {
                    badge.textContent = cartCount;
                    badge.classList.toggle('hidden', cartCount === 0);
                });
                document.querySelectorAll('[data-favorite-count]').forEach(function (badge) {
                    badge.textContent = favorites.length;
                    badge.classList.toggle('hidden', favorites.length === 0);
                });
            }

            function addToCart(data) {
                var cart = read(cartKey);
                var key = [data.id, data.color || 'Default', data.size || 'One size'].join('::');
                var existing = cart.find(function (item) { return item.key === key; });
                if (existing) {
                    existing.quantity = Number(existing.quantity || 1) + 1;
                } else {
                    cart.push(Object.assign({ key: key, quantity: 1 }, data));
                }
                write(cartKey, cart);
                updateCounts();
                window.dispatchEvent(new CustomEvent('skadoosh:cart-updated'));
            }

            function renderFavorites() {
                var target = document.querySelector('[data-favorites-list]');
                if (!target) return;
                var favorites = read(favoriteKey);
                if (!favorites.length) {
                    target.innerHTML = '<p class="text-sm" style="color:#64748b !important;">No favorites yet. Tap the heart on a product to save it here.</p>';
                    return;
                }
                target.innerHTML = favorites.map(function (item) {
                    return '<a class="flex gap-3 rounded-xl border border-slate-200 p-3" href="' + item.url + '" style="text-decoration:none;">' +
                        (item.image ? '<img src="' + item.image + '" alt="" class="h-16 w-14 rounded-lg object-cover">' : '') +
                        '<span><strong class="block">' + item.name + '</strong><span class="block text-sm" style="color:#7a0000 !important;">' + formatPeso(item.price) + '</span></span>' +
                        '</a>';
                }).join('');
            }

            document.addEventListener('click', function (event) {
                var opener = event.target.closest('[data-open-panel]');
                if (opener) {
                    event.preventDefault();
                    openPanel(opener.dataset.openPanel);
                    return;
                }

                if (event.target.closest('[data-close-panels]') || event.target === backdrop) {
                    closePanels();
                    closeLoginModal();
                    if (backdrop) backdrop.classList.remove('is-open');
                    return;
                }

                if (event.target.closest('[data-close-login-modal]')) {
                    closeLoginModal();
                    if (backdrop) backdrop.classList.remove('is-open');
                    return;
                }

                var favoritesEntry = event.target.closest('[data-favorites-entry]');
                if (favoritesEntry) {
                    event.preventDefault();
                    if (!isAuthenticated) {
                        openLoginModal();
                    } else {
                        openPanel('favorites');
                    }
                    return;
                }

                var favoriteButton = event.target.closest('[data-favorite-product]');
                if (favoriteButton) {
                    event.preventDefault();
                    event.stopPropagation();
                    if (!isAuthenticated) {
                        openLoginModal();
                        return;
                    }
                    var favorites = read(favoriteKey);
                    var data = favoriteButton.dataset;
                    var index = favorites.findIndex(function (item) { return item.id === data.id; });
                    if (index >= 0) {
                        favorites.splice(index, 1);
                        favoriteButton.classList.remove('is-favorited');
                    } else {
                        favorites.push({ id: data.id, name: data.name, price: data.price, image: data.image, url: data.url });
                        favoriteButton.classList.add('is-favorited');
                    }
                    write(favoriteKey, favorites);
                    updateCounts();
                    return;
                }

                var cartButton = event.target.closest('[data-add-cart]');
                if (cartButton) {
                    event.preventDefault();
                    event.stopPropagation();
                    if (!isAuthenticated) {
                        openLoginModal();
                        return;
                    }
                    addToCart({
                        id: cartButton.dataset.id,
                        name: cartButton.dataset.name,
                        price: cartButton.dataset.price,
                        image: cartButton.dataset.image,
                        url: cartButton.dataset.url,
                        category: cartButton.dataset.category || 'Skadoosh',
                        color: cartButton.dataset.color || 'Default',
                        size: cartButton.dataset.size || 'One size'
                    });
                    if (cartButton.dataset.redirect === 'cart') {
                        window.location.href = body.dataset.cartUrl;
                    } else {
                        cartButton.textContent = 'Added to cart';
                        setTimeout(function () { cartButton.textContent = cartButton.dataset.originalText || 'Add to cart'; }, 1200);
                    }
                }
            });

            document.querySelectorAll('[data-add-cart]').forEach(function (button) {
                button.dataset.originalText = button.textContent.trim();
            });

            var searchInput = document.querySelector('[data-site-search]');
            var searchResults = document.querySelector('[data-search-results]');
            var searchForm = document.querySelector('[data-site-search-form]');
            var productSearchCache = null;
            var productSearchLoading = null;
            var defaultSearchResultsHtml = searchResults ? searchResults.innerHTML : '';

            function escapeHtml(value) {
                return String(value || '').replace(/[&<>"']/g, function (char) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char];
                });
            }

            function productImageUrl(imageUrl) {
                if (!imageUrl) return '';
                if (/^https?:\/\//i.test(imageUrl)) return imageUrl;
                return imageUrl.charAt(0) === '/' ? imageUrl : '/' + imageUrl;
            }

            function fetchProductsForSearch() {
                if (productSearchCache) {
                    return Promise.resolve(productSearchCache);
                }
                if (productSearchLoading) {
                    return productSearchLoading;
                }
                productSearchLoading = fetch(body.dataset.productsApiUrl || '/api/customer/products', {
                    headers: { 'Accept': 'application/json' }
                })
                    .then(function (response) { return response.ok ? response.json() : Promise.reject(new Error('Search request failed')); })
                    .then(function (payload) {
                        productSearchCache = (((payload || {}).data || {}).products || []);
                        return productSearchCache;
                    })
                    .catch(function () {
                        productSearchCache = [];
                        return productSearchCache;
                    });
                return productSearchLoading;
            }

            function renderSearchMatches(matches, query) {
                if (!searchResults) return;
                if (!query) {
                    searchResults.innerHTML = defaultSearchResultsHtml;
                    return;
                }
                if (matches.length) {
                    searchResults.innerHTML = matches.map(function (product) {
                        var url = (body.dataset.shopUrl || '/shop') + '/' + encodeURIComponent(product.id);
                        var image = productImageUrl(product.imageUrl);
                        return '<a class="rounded-xl border border-slate-200 p-4 flex gap-3 items-center hover:border-red-900/30" href="' + url + '" style="text-decoration:none;">' +
                            (image ? '<img src="' + escapeHtml(image) + '" alt="" class="h-16 w-14 rounded-lg object-cover bg-slate-100">' : '') +
                            '<span class="min-w-0"><strong class="block truncate">' + escapeHtml(product.name || product.title || 'Product') + '</strong>' +
                            '<span class="block text-sm mt-1" style="color:#64748b !important;">' + escapeHtml(product.category || product.categoryName || 'Skadoosh') + '</span>' +
                            '<span class="block text-sm font-extrabold mt-1" style="color:#7a0000 !important;">' + formatPeso(product.price) + '</span></span>' +
                            '</a>';
                    }).join('');
                    return;
                }
                searchResults.innerHTML =
                    '<a class="rounded-xl border border-slate-200 p-4 block sm:col-span-3" href="' + (body.dataset.shopUrl || '/shop') + '?q=' + encodeURIComponent(query) + '" style="text-decoration:none;">' +
                    '<strong>Search shop for "' + escapeHtml(query) + '"</strong>' +
                    '<span class="block text-sm mt-1" style="color:#64748b !important;">No quick matches found. Open full shop results.</span>' +
                    '</a>';
            }

            if (searchInput && searchResults) {
                searchInput.addEventListener('input', function () {
                    var q = searchInput.value.trim().toLowerCase();
                    if (!q) {
                        renderSearchMatches([], '');
                        return;
                    }
                    fetchProductsForSearch().then(function (products) {
                        var matches = products.filter(function (product) {
                            var haystack = [
                                product.name,
                                product.title,
                                product.description,
                                product.category,
                                product.categoryName
                            ].join(' ').toLowerCase();
                            return haystack.indexOf(q) !== -1;
                        }).slice(0, 6);
                        renderSearchMatches(matches, searchInput.value.trim());
                    });
                    var cards = Array.from(document.querySelectorAll('[data-product-search]'));
                    if (!cards.length) return;
                    var matches = cards.filter(function (card) {
                        return (card.dataset.productSearch || '').toLowerCase().includes(q);
                    }).slice(0, 6);
                    if (matches.length) searchResults.innerHTML = matches.map(function (card) {
                        return '<a class="rounded-xl border border-slate-200 p-4" href="' + card.dataset.productUrl + '"><strong>' + card.dataset.productName + '</strong><span class="block text-sm mt-1">' + (card.dataset.productCategory || 'Skadoosh') + '</span></a>';
                    }).join('');
                });
            }

            if (searchForm && searchInput) {
                searchForm.addEventListener('submit', function (event) {
                    var query = searchInput.value.trim();
                    if (!query) {
                        event.preventDefault();
                        searchInput.focus();
                    }
                });
            }

            updateCounts();
        })();
    </script>
    {% block javascripts %}{% endblock %}
</body>
</html>