                        <nav class="mt-4 grid gap-2 text-sm">
                            <a href="{{ path('app_shop') }}?category=mens" style="color:rgba(226,232,240,0.86) !important;">Mens</a>
                            <a href="{{ path('app_shop') }}?category=womens" style="color:rgba(226,232,240,0.86) !important;">Womens</a>
                            <a href="{{ path('app_shop') }}?category=accessories" style="color:rgba(226,232,240,0.86) !important;">Accessories</a>
                            <a href="{{ path('app_shop') }}" style="color:rgba(226,232,240,0.86) !important;">New arrivals</a>
