                    </section>
                    <section>
                        <h2 class="text-xs font-extrabold uppercase tracking-[0.24em]" style="color:#ffffff !important;">Help</h2>
                        <nav class="mt-4 grid gap-2 text-sm">
                            <a href="{{ path('app_page_contact') }}" style="color:rgba(226,232,240,0.86) !important;">Contact</a>
                            <a href="{{ path('app_page_contact') }}#faq" style="color:rgba(226,232,240,0.86) !important;">FAQ</a>
                            <a href="{{ path('app_cart') }}" style="color:rgba(226,232,240,0.86) !important;">Cart</a>
