<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}SKADOOSH{% endblock %}</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts - Inter (TailAdmin Style) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* Modern Typography - Inter Font */
        * {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            background-image: url('{{ asset('Pattern.png') }}');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            margin: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
            font-size: 14px;
            line-height: 1.6;
            color: #1e293b !important;
            font-weight: 400;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 700 !important;
            color: #0f172a !important;
            line-height: 1.2;
            letter-spacing: -0.02em;
        }

        p, span, div, label, a {
            color: #334155 !important;
            font-weight: 400;
        }

        /* Smart font color - adapts to background */
        body, body * {
            color: #111827 !important;
        }

        /* White/light backgrounds - dark text */
        .bg-white, .bg-gray-50, .bg-gray-100,
        [style*="background-color: rgba(255, 255, 255"],
        [style*="background: white"] {
            color: #111827 !important;
        }

        .bg-white *, .bg-gray-50 *, .bg-gray-100 *,
        [style*="background-color: rgba(255, 255, 255"] * {
            color: #111827 !important;
        }

        /* Dark backgrounds - light text */
        .bg-slate-800, .bg-slate-700, .bg-slate-900, .dark,
        [style*="background-color: rgba(30, 41, 59"],
        [style*="background: #1e293b"] {
            color: #f8fafc !important;
        }

        .bg-slate-800 *, .bg-slate-700 *, .bg-slate-900 *, .dark *,
        [style*="background-color: rgba(30, 41, 59"] * {
            color: #f8fafc !important;
        }

        /* Better contrast for text */
        h1, h2, h3, h4, h5, h6 {
            color: #000000 !important;
            font-weight: 700;
        }

        /* Override for dark backgrounds */
        .bg-slate-800 h1, .bg-slate-800 h2, .bg-slate-800 h3,
        .bg-slate-700 h1, .bg-slate-700 h2, .bg-slate-700 h3,
        .dark h1, .dark h2, .dark h3 {
            color: #ffffff !important;
        }

        p, span, div, label, a {
            color: #111827 !important;
        }

        /* Override light text on white backgrounds */
        .bg-white .text-gray-400, .bg-white .text-gray-500, .bg-white .text-gray-600 {
            color: #4b5563 !important;
        }

        /* Override dark text on dark backgrounds */
        .bg-slate-800 .text-gray-900, .bg-slate-700 .text-gray-900 {
            color: #f8fafc !important;
        }

        /* Page content wrapper is styled per page; keep main neutral */
        main {
            margin: 0;
            padding: 0;
            background: transparent;
            box-shadow: none;
            border-radius: 0;
        }

        /* Modern Card Styles */
        .card {
            background: white;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }

        .card:hover {
            box-shadow: 0 20px 40px -5px rgba(0, 0, 0, 0.15), 0 8px 12px -4px rgba(0, 0, 0, 0.08);
        }

        /* Modern Button Styles */
        .btn-primary, button.btn-primary, a.btn-primary {
            background: linear-gradient(135deg, #7a0000 0%, #9a0000 100%);
            color: #ffffff !important;
            padding: 0.75rem 1.5rem;
            border-radius: 0.5rem;
            font-weight: 600;
            font-size: 0.875rem;
            letter-spacing: 0.01em;
            border: none;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 3px 0 rgba(122, 0, 0, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
            font-family: 'Inter', sans-serif !important;
        }

        .btn-primary:hover, button.btn-primary:hover, a.btn-primary:hover {
            background: linear-gradient(135deg, #6a0000 0%, #8a0000 100%);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(122, 0, 0, 0.35);
            color: #ffffff !important;
        }

        .btn-secondary {
            background-color: #f3f4f6;
            color: #374151;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
            font-weight: 600;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-secondary:hover {
            background-color: #e5e7eb;
        }

        /* Input Focus Styles */
        input[type="text"]:focus,
        input[type="password"]:focus,
        input[type="email"]:focus,
        input[type="number"]:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: #7a0000;
            box-shadow: 0 0 0 3px rgba(122, 0, 0, 0.1);
        }

        /* Enhanced form inputs */
        input[type="text"],
        input[type="password"],
        input[type="email"],
        input[type="number"],
        textarea,
        select {
            transition: all 0.2s ease;
        }

        /* Smooth transitions for interactive elements */
        a, button {
            transition: all 0.2s ease;
        }

        /* Override any light text colors */
        .text-gray-400, .text-gray-500, .text-gray-600 {
            color: #111827 !important;
        }

        /* Ensure links are visible */
        a:not(.btn-primary) {
            color: #111827 !important;
        }

        a:not(.btn-primary):hover {
            color: #7a0000 !important;
        }

        /* Dark mode support */
        .dark body {
            background-color: #0f172a;
        }

        .dark body * {
            color: #e2e8f0 !important;
        }

        .dark .card {
            background-color: #1e293b;
            border-color: #334155;
        }

        .dark input {
            background-color: #0f172a;
            border-color: #334155;
            color: #e2e8f0 !important;
        }

        .dark input:focus {
            border-color: #7a0000;
            box-shadow: 0 0 0 3px rgba(122, 0, 0, 0.2);
        }

        .dark main {
            background-color: rgba(30, 41, 59, 0.95) !important;
        }

        /* Smooth animations */
        main {
            animation: fadeIn 0.4s ease-in-out;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Enhanced button interactions */
        .btn-primary, .btn-secondary, button, a.btn {
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-primary:active, .btn-secondary:active, button:active {
            transform: scale(0.98);
        }

        /* Header nav active indicator */
        .site-nav a.site-link {
            position: relative;
            padding: 0.4rem 0.55rem;
            border-radius: 0.6rem;
        }
        .site-nav a.site-link.is-active {
            background: rgba(122, 0, 0, 0.18);
            box-shadow: inset 0 0 0 1px rgba(248, 250, 252, 0.18);
        }
        .site-nav a.site-link.is-active::after {
            content: "";
            position: absolute;
            left: 0.55rem;
            right: 0.55rem;
            bottom: -0.35rem;
            height: 2px;
            background: #ffffff;
            border-radius: 999px;
            opacity: 0.95;
        }

        .sk-site-header,
        .sk-footer,
        .sk-panel,
        .sk-modal {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
        }

        .sk-site-header {
            background: rgba(8, 13, 24, 0.96);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.10);
        }

        .sk-nav-link,
        .sk-icon-button {
            color: #f8fafc !important;
        }

        .sk-site-header a.sk-nav-link,
        .sk-site-header a:not(.btn-primary).sk-nav-link {
            color: #f8fafc !important;
        }

        .sk-nav-link {
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .sk-nav-link:hover {
            color: #ffffff !important;
        }

        .sk-icon-button {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.35rem;
            height: 2.35rem;
            border-radius: 999px;
            border: 1px solid rgba(255, 255, 255, 0.18);
            background: rgba(255, 255, 255, 0.06);
            color: #ffffff !important;
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.08), 0 8px 22px rgba(0, 0, 0, 0.22);
        }

        .sk-site-header .sk-icon-button,
        .sk-site-header a.sk-icon-button,
        .sk-site-header button.sk-icon-button {
            color: #ffffff !important;
            opacity: 1 !important;
        }

        .sk-site-header .sk-icon-button svg,
        .sk-site-header .sk-icon-button svg path {
            color: #ffffff !important;
            stroke: #ffffff !important;
        }

        .sk-icon-button:hover {
            background: rgba(255, 255, 255, 0.18);
            border-color: rgba(255, 255, 255, 0.52);
            box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.18), 0 10px 26px rgba(0, 0, 0, 0.28);
        }

        .sk-badge {
            position: absolute;
            top: -0.35rem;
            right: -0.35rem;
            min-width: 1.15rem;
            height: 1.15rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0 0.25rem;
            background: #dc2626;
            color: #ffffff !important;
            font-size: 0.65rem;
            font-weight: 800;
        }

        .sk-panel-backdrop {
            position: fixed;
            inset: 0;
            z-index: 80;
            background: rgba(2, 6, 23, 0.58);
            opacity: 0;
            pointer-events: none;
            transition: opacity 180ms ease;
        }

        .sk-panel-backdrop.is-open {
            opacity: 1;
            pointer-events: auto;
        }

        .sk-panel {
            position: fixed;
            z-index: 90;
            background: rgba(255, 255, 255, 0.98);
            box-shadow: 0 24px 80px rgba(2, 6, 23, 0.24);
            transition: transform 220ms ease;
        }

        .sk-panel-left {
            top: 0;
            left: 0;
            height: 100vh;
            width: min(24rem, 90vw);
            transform: translateX(-105%);
        }

        .sk-panel-right {
            top: 0;
            right: 0;
            height: 100vh;
            width: min(28rem, 92vw);
            transform: translateX(105%);
        }

        .sk-panel-top {
            top: 0;
            left: 0;
            right: 0;
            transform: translateY(-105%);
        }

        .sk-panel.is-open {
            transform: translate(0, 0);
        }

        .sk-modal {
            position: fixed;
            z-index: 95;
            left: 50%;
            top: 50%;
            width: min(26rem, calc(100vw - 2rem));
            transform: translate(-50%, -45%) scale(0.98);
            opacity: 0;
            pointer-events: none;
            border-radius: 1.25rem;
            background: #ffffff;
            box-shadow: 0 24px 80px rgba(2, 6, 23, 0.26);
            transition: all 180ms ease;
        }

        .sk-modal.is-open {
            opacity: 1;
            pointer-events: auto;
            transform: translate(-50%, -50%) scale(1);
        }

        .sk-footer {
            background:
                linear-gradient(rgba(7, 12, 22, 0.94), rgba(7, 12, 22, 0.96)),
                url('{{ asset('Pattern2.png') }}');
            background-size: cover;
            color: #f8fafc !important;
        }

        @media (max-width: 768px) {
            .sf-toolbar,
            #sfToolbarMainContent {
                display: none !important;
            }
        }
    </style>
    
    {% block stylesheets %}{% endblock %}
</head>
<body class="bg-gray-50 dark:bg-slate-900 min-h-screen flex flex-col" data-authenticated="{{ app.user ? '1' : '0' }}" data-login-url="{{ path('app_login') }}" data-cart-url="{{ path('app_cart') }}" data-shop-url="{{ path('app_shop') }}" data-products-api-url="{{ path('api_customer_products') }}">
    <!-- Public Ecommerce Header -->
    {% set currentRoute = app.request.attributes.get('_route') %}
    <header class="sk-site-header sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6">
            <div class="relative flex items-center justify-between min-h-[84px] gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    <button type="button" class="sk-icon-button" data-open-panel="menu" aria-label="Open category menu">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                </div>

                <a href="{{ path('app_page') }}" class="absolute left-1/2 -translate-x-1/2 inline-flex items-center justify-center" aria-label="Skadoosh home">
                    <img src="{{ asset('Logo.png') }}" alt="SKADOOSH Logo" class="h-14 sm:h-16 w-auto transition-transform hover:scale-105" style="filter: brightness(1.18) drop-shadow(0 8px 20px rgba(255,255,255,0.18));">
                </a>

                <div class="flex items-center justify-end gap-2 sm:gap-3">
                    <button type="button" class="sk-icon-button" data-open-panel="search" aria-label="Search">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 21-4.35-4.35M10.8 18a7.2 7.2 0 1 1 0-14.4 7.2 7.2 0 0 1 0 14.4Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </button>
                    <button type="button" class="sk-icon-button" data-favorites-entry aria-label="Favorites">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5S4.5 16.1 4.5 9.9A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 2.3c0 6.2-7.5 10.6-7.5 10.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
                        <span class="sk-badge hidden" data-favorite-count>0</span>
                    </button>
                    <a class="sk-icon-button" href="{{ path('app_cart') }}" aria-label="Shopping cart">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6.2 6h15l-1.7 8.5H8L6.2 3H3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><path d="M9 20a1 1 0 1 0 0-2 1 1 0 0 0 0 2Zm9 0a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" fill="currentColor"/></svg>
                        <span class="sk-badge hidden" data-cart-count>0</span>
                    </a>
                    <a class="sk-icon-button" href="{{ path('app_customization_new') }}" aria-label="Customization">
                        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3v3M12 18v3M4.2 7.5l2.6 1.5M17.2 15l2.6 1.5M4.2 16.5 6.8 15M17.2 9l2.6-1.5M9 12a3 3 0 1 0 6 0 3 3 0 0 0-6 0Z" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </header>

    <div class="sk-panel-backdrop" data-panel-backdrop></div>

    <aside class="sk-panel sk-panel-left p-6 overflow-y-auto" data-panel="menu" aria-label="Category menu">
        <div class="flex items-center justify-between gap-4">
            <img src="{{ asset('PrimaryLogo.png') }}" alt="SKADOOSH" class="h-10 w-auto">
            <button type="button" class="text-sm font-bold" data-close-panels aria-label="Close menu">Close</button>
        </div>
        <p class="mt-8 text-xs font-extrabold uppercase tracking-[0.25em]" style="color:#7a0000 !important;">Shop the floor</p>
        <nav class="mt-5 grid gap-3">
            <a href="{{ path('app_shop') }}?category=mens" class="rounded-xl border border-slate-200 p-4 hover:border-red-900/30" style="text-decoration:none;">
                <strong class="block text-lg">Mens</strong>
                <span class="block mt-1 text-sm" style="color:#64748b !important;">Graphic tees, strong layers, daily fits.</span>
            </a>
            <a href="{{ path('app_shop') }}?category=womens" class="rounded-xl border border-slate-200 p-4 hover:border-red-900/30" style="text-decoration:none;">
                <strong class="block text-lg">Womens</strong>
                <span class="block mt-1 text-sm" style="color:#64748b !important;">Clean silhouettes and statement comfort.</span>
            </a>
            <a href="{{ path('app_shop') }}?category=accessories" class="rounded-xl border border-slate-200 p-4 hover:border-red-900/30" style="text-decoration:none;">
                <strong class="block text-lg">Accessories</strong>
                <span class="block mt-1 text-sm" style="color:#64748b !important;">Finish the look with Skadoosh details.</span>
            </a>
        </nav>
        <div class="mt-8 border-t border-slate-200 pt-6 grid gap-3 text-sm font-semibold">
            <a href="{{ path('app_page') }}">Home</a>
            {% if app.user and ('ROLE_ADMIN' in app.user.roles or 'ROLE_STAFF' in app.user.roles) %}
                <a href="{{ 'ROLE_ADMIN' in app.user.roles ? path('app_admin_dashboard') : path('app_products_index') }}">Dashboard</a>
            {% endif %}
            <a href="{{ path('app_customization_new') }}">Custom Studio</a>
            {% if app.user %}
                <a href="{{ path('app_customer_profile') }}">Profile</a>
                <a href="{{ path('app_my_orders') }}">My Orders</a>
                <a href="{{ path('app_my_customization_requests') }}">My Customization Requests</a>
            {% endif %}
            <a href="{{ path('app_page_about') }}">About Skadoosh</a>
            <a href="{{ path('app_page_contact') }}">Contact support</a>
            {% if app.user %}
                <a href="{{ path('app_logout') }}">Logout</a>
            {% else %}
                <a href="{{ path('app_login') }}">Login / Account</a>
            {% endif %}
        </div>
    </aside>

    <section class="sk-panel sk-panel-top p-5 sm:p-7" data-panel="search" aria-label="Search panel">
        <div class="max-w-5xl mx-auto">
            <div class="flex items-center justify-between gap-4">
                <h2 class="text-xl font-extrabold">Search Skadoosh</h2>
                <button type="button" class="text-sm font-bold" data-close-panels>Close</button>
            </div>
            <form class="block mt-5" data-site-search-form action="{{ path('app_shop') }}" method="get">
                <span class="sr-only">Search</span>
                <input type="search" name="q" data-site-search class="w-full rounded-xl border border-slate-200 px-5 py-4 text-lg bg-white" placeholder="Search products, mens, womens, accessories..." autocomplete="off">
            </form>
            <div class="mt-5 grid sm:grid-cols-3 gap-3" data-search-results>
                <a class="rounded-xl border border-slate-200 p-4" href="{{ path('app_shop') }}?category=mens"><strong>Mens</strong><span class="block text-sm mt-1">Shop menswear</span></a>
                <a class="rounded-xl border border-slate-200 p-4" href="{{ path('app_shop') }}?category=womens"><strong>Womens</strong><span class="block text-sm mt-1">Shop womenswear</span></a>
                <a class="rounded-xl border border-slate-200 p-4" href="{{ path('app_shop') }}?category=accessories"><strong>Accessories</strong><span class="block text-sm mt-1">Complete the fit</span></a>
            </div>
        </div>
    </section>

    <aside class="sk-panel sk-panel-right p-6 overflow-y-auto" data-panel="customize" aria-label="Customization drawer">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.25em]" style="color:#7a0000 !important;">Custom Studio</p>
                <h2 class="mt-2 text-2xl font-extrabold">Design your Skadoosh piece</h2>
            </div>
            <button type="button" class="text-sm font-bold" data-close-panels>Close</button>
        </div>
        <div class="mt-7 grid gap-3">
            <a href="{{ path('app_customization_new') }}?type=tshirt" class="rounded-xl border border-slate-200 p-4 hover:border-red-900/30" style="text-decoration:none;">
                <strong class="block text-lg">Tshirt</strong>
            </a>
            <a href="{{ path('app_customization_new') }}?type=accessories" class="rounded-xl border border-slate-200 p-4 hover:border-red-900/30" style="text-decoration:none;">
                <strong class="block text-lg">Accessories (Tote Bag Only)</strong>
            </a>
        </div>
        <a href="{{ path('app_customization_new') }}" class="btn-primary w-full mt-6">Open customization page</a>
    </aside>

    <aside class="sk-panel sk-panel-right p-6 overflow-y-auto" data-panel="favorites" aria-label="Favorites drawer">
        <div class="flex items-center justify-between gap-4">
            <div>
                <p class="text-xs font-extrabold uppercase tracking-[0.25em]" style="color:#7a0000 !important;">Saved looks</p>
                <h2 class="mt-2 text-2xl font-extrabold">Favorites</h2>
            </div>
            <button type="button" class="text-sm font-bold" data-close-panels>Close</button>
        </div>
        <div class="mt-6 space-y-3" data-favorites-list>
            <p class="text-sm" style="color:#64748b !important;">No favorites yet. Tap the heart on a product to save it here.</p>
        </div>
    </aside>

    <div class="sk-modal p-6" data-login-modal role="dialog" aria-modal="true" aria-label="Login required">
        <h2 class="text-2xl font-extrabold">Login required</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:#475569 !important;">Please log in before adding products to your cart or saving items to your Skadoosh account.</p>
        <div class="mt-6 flex flex-col sm:flex-row gap-3">
            <a href="{{ path('app_login') }}" class="btn-primary flex-1">Log in</a>
            <button type="button" class="btn-secondary flex-1" data-close-login-modal>Cancel</button>
        </div>
    </div>

    <!-- Main Content -->
    <main class="flex-1">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-4">
                    <div class="rounded-xl border px-5 py-4 text-sm font-semibold {% if label == 'success' %}border-green-200 bg-green-50{% elseif label == 'warning' %}border-amber-200 bg-amber-50{% else %}border-slate-200 bg-white{% endif %}">
                        {{ message }}
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </main>

    <!-- Ecommerce Footer -->
