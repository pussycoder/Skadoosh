{% extends 'base.html.twig' %}

{% block title %}Contact Us - SKADOOSH{% endblock %}

{% block stylesheets %}
<style>
  .contact-hero {
    background:
      linear-gradient(120deg, rgba(8,13,24,0.95), rgba(50,12,18,0.88)),
      url('{{ asset('Pattern2.png') }}');
    background-size: cover;
  }
  .contact-card {
    background: rgba(255, 255, 255, 0.93);
    border: 1px solid rgba(148, 163, 184, 0.30);
    box-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
  }
</style>
{% endblock %}

{% block body %}
<section class="pb-16">
  <header class="contact-hero">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 sm:py-20 text-center">
      <p class="text-xs font-extrabold uppercase tracking-[0.3em] mb-4" style="color:rgba(226,232,240,0.82) !important;">Contact Skadoosh</p>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight" style="color:#ffffff !important;">Need help with your fit?</h1>
      <p class="mt-6 max-w-2xl mx-auto text-base sm:text-lg leading-relaxed" style="color:rgba(226,232,240,0.88) !important;">Orders, sizing, product questions, account support, collaborations, or custom design ideas: send us a message and we will help you move forward.</p>
    </div>
  </header>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-10 grid grid-cols-1 lg:grid-cols-12 gap-7">
    <div class="lg:col-span-8">
      {% for msg in app.flashes('error') %}
        <p class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium" style="color:#7a0000 !important;">
          {{ msg }}
        </p>
      {% endfor %}

      {% if app.request.query.get('sent') == '1' %}
        <p class="mb-6 rounded-lg border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium" style="color:#065f46 !important;">
          Thanks! Your message was sent. If you do not hear back within 24-48 hours, email us directly below.
        </p>
      {% endif %}

      <form action="{{ path('app_page_contact') }}" method="POST" class="contact-card rounded-[2rem] p-6 sm:p-8 space-y-5">
        <input type="hidden" name="_token" value="{{ csrf_token('contact') }}">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.25em]" style="color:#7a0000 !important;">Support form</p>
          <h2 class="mt-2 text-2xl sm:text-3xl font-extrabold">Send a message</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color:#64748b !important;">This preserves the existing Symfony Mailer contact functionality.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <label class="block text-sm font-bold" for="name">Full name
            <input id="name" name="name" type="text" required class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="Your name">
          </label>
          <label class="block text-sm font-bold" for="email">Email
            <input id="email" name="email" type="email" required class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="you@example.com">
          </label>
        </div>

        <label class="block text-sm font-bold" for="topic">Topic
          <select id="topic" name="topic" class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 bg-white">
            <option>Order concern</option>
            <option>Product / sizing</option>
            <option>Account / login</option>
            <option>Customization request</option>
            <option>Partnership</option>
            <option>Other</option>
          </select>
        </label>

        <label class="block text-sm font-bold" for="message">Message
          <textarea id="message" name="message" rows="6" required class="mt-2 w-full rounded-lg border border-gray-200 px-4 py-3 bg-white" placeholder="Tell us what you need..."></textarea>
        </label>

        <button type="submit" class="btn-primary">Submit message</button>
      </form>
    </div>

    <aside class="lg:col-span-4 space-y-5">
      <section class="contact-card rounded-3xl p-6">
        <h2 class="text-xl font-extrabold">Fast contact</h2>
        <address class="not-italic mt-5 space-y-5 text-sm" style="color:#374151 !important;">
          <p>
            <span class="block text-xs font-extrabold uppercase tracking-wider mb-1" style="color:#7a0000 !important;">Email</span>
            <a href="mailto:support@skadoosh.com" class="hover:underline">support@skadoosh.com</a>
          </p>
          <p>
            <span class="block text-xs font-extrabold uppercase tracking-wider mb-1" style="color:#7a0000 !important;">Phone</span>
            <a href="tel:+15551234567" class="hover:underline">+1 (555) 123-4567</a>
          </p>
          <p>
            <span class="block text-xs font-extrabold uppercase tracking-wider mb-1" style="color:#7a0000 !important;">Address</span>
            123 Fashion St, Style City, SC 12345
          </p>
        </address>
      </section>

      <section class="contact-card rounded-3xl p-6" id="sizing">
        <h2 class="text-xl font-extrabold">Sizing help</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:#64748b !important;">If customers are unsure, they can send height, usual shirt size, and preferred fit. For demo day, this shows real ecommerce support thinking.</p>
        <a href="{{ path('app_customization_new') }}" class="btn-secondary mt-4 w-full">Send custom fit note</a>
      </section>
    </aside>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12" aria-labelledby="support-heading">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      <article class="contact-card rounded-3xl p-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em]" style="color:#7a0000 !important;">Orders</p>
        <h2 class="mt-3 text-xl font-extrabold">Cart and checkout</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:#475569 !important;">Use the cart icon to review items. Checkout can later connect the local cart to Symfony Orders.</p>
      </article>
      <article class="contact-card rounded-3xl p-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em]" style="color:#7a0000 !important;">Products</p>
        <h2 class="mt-3 text-xl font-extrabold">Sizing and care</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:#475569 !important;">Ask about sizing, color, category availability, or uploaded product images from the admin catalog.</p>
      </article>
      <article class="contact-card rounded-3xl p-6">
        <p class="text-xs font-extrabold uppercase tracking-[0.24em]" style="color:#7a0000 !important;">Custom</p>
        <h2 class="mt-3 text-xl font-extrabold">Design requests</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:#475569 !important;">Use the customization drawer for a quick demo request, then contact us for a longer brief.</p>
      </article>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12" id="faq" aria-labelledby="faq-heading">
    <div class="contact-card rounded-[2rem] p-6 sm:p-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-6">
        <div>
          <p class="text-xs font-extrabold uppercase tracking-[0.28em]" style="color:#7a0000 !important;">FAQ</p>
          <h2 id="faq-heading" class="mt-2 text-3xl font-extrabold">Questions customers may ask</h2>
        </div>
        <a href="{{ path('app_shop') }}" class="text-sm font-bold underline" style="color:#7a0000 !important;">Back to shop</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {% set faqs = [
          {'q': 'Do I need an account to favorite items?', 'a': 'Yes. Guests see a login prompt when tapping favorites, matching the customer account flow.'},
          {'q': 'Does the cart save?', 'a': 'For this demo, cart items save in the browser with localStorage.'},
          {'q': 'Where do product images come from?', 'a': 'They use uploaded filenames from the Products admin module.'},
          {'q': 'Can customers request custom designs?', 'a': 'Yes. The customization icon opens a request drawer for product type, color, size, and notes.'}
        ] %}
        {% for item in faqs %}
          <article class="rounded-2xl border border-slate-200 p-5 bg-white">
            <h3 class="font-extrabold">{{ item.q }}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color:#475569 !important;">{{ item.a }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-12">
    <div class="contact-card rounded-[2rem] p-8 sm:p-10 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-7">
      <div>
        <p class="text-xs font-extrabold uppercase tracking-[0.28em]" style="color:#7a0000 !important;">Need something now?</p>
        <h2 class="mt-2 text-3xl font-extrabold">Start shopping or send a support note.</h2>
      </div>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="{{ path('app_shop') }}" class="btn-primary">Shop latest drops</a>
        <button type="button" class="btn-secondary" data-open-panel="search">Search products</button>
      </div>
    </div>
  </section>
</section>
{% endblock %}
