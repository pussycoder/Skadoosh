{% extends 'base.html.twig' %}

{% block title %}My Customization Requests - SKADOOSH{% endblock %}

{% block stylesheets %}
<style>
  body {
    background-image: url('{{ asset('Pattern.png') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  .requests-hero {
    background: linear-gradient(135deg, #080d18 0%, #1f2937 55%, #080d18 100%);
  }
  .request-card {
    background: rgba(255,255,255,0.96);
    border: 1px solid rgba(148,163,184,0.35);
    box-shadow: 0 20px 60px rgba(15,23,42,0.08);
  }
</style>
{% endblock %}

{% block body %}
<section class="pb-16">
  <header class="requests-hero">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <p class="text-xs font-extrabold uppercase tracking-[0.28em] mb-3" style="color:rgba(226,232,240,0.86) !important;">Customer requests</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold" style="color:#ffffff !important;">My Customization Requests</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color:rgba(226,232,240,0.88) !important;">Track your submitted designs, request status, and staff responses.</p>
      <div class="mt-6 flex flex-col sm:flex-row gap-3">
        <a href="{{ path('app_customization_new') }}" class="btn-primary">Create New Design</a>
        <a href="{{ path('app_customer_profile') }}" class="btn-secondary">Back to Profile</a>
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-10">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {% for request in customizationRequests %}
        <article class="request-card rounded-3xl p-5 sm:p-6">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="text-xl font-extrabold">{{ request.productType }}</h2>
              <p class="mt-1 text-xs" style="color:#64748b !important;">Submitted {{ request.createdAt ? request.createdAt|date('M d, Y g:i A') : '' }}</p>
            </div>
            <span class="rounded-full px-3 py-1 text-xs font-extrabold" style="background:rgba(122,0,0,0.08); color:#7a0000 !important;">{{ request.status }}</span>
          </div>

          {% if request.designSnapshot %}
            <img src="{{ request.designSnapshot }}" alt="Submitted customization design" class="mt-5 w-full max-h-80 object-contain rounded-2xl bg-slate-50 border border-slate-200">
          {% else %}
            <div class="mt-5 rounded-2xl border border-dashed border-slate-300 p-8 text-center text-sm" style="color:#64748b !important;">No design image saved for this older request.</div>
          {% endif %}

          <dl class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
            <div class="rounded-xl bg-slate-50 p-3">
              <dt class="font-bold">Size / Fit</dt>
              <dd class="mt-1" style="color:#475569 !important;">{{ request.size ?: 'Not specified' }}</dd>
            </div>
            <div class="rounded-xl bg-slate-50 p-3">
              <dt class="font-bold">Fabric</dt>
              <dd class="mt-1" style="color:#475569 !important;">{{ request.placement ?: 'Not specified' }}</dd>
            </div>
          </dl>

          {% if request.notes %}
            <p class="mt-4 rounded-xl bg-white border border-slate-200 p-3 text-sm" style="color:#334155 !important;"><strong>Notes:</strong> {{ request.notes }}</p>
          {% endif %}

          <div class="mt-4 rounded-xl bg-slate-50 p-3 text-sm" style="color:#334155 !important;">
            <strong>Staff response:</strong>
            <span class="block mt-1 whitespace-pre-line">{{ request.staffResponse ?: 'No response yet.' }}</span>
          </div>
        </article>
      {% else %}
        <div class="request-card rounded-3xl p-8 md:col-span-2 text-center">
          <h2 class="text-2xl font-extrabold">No customization requests yet</h2>
          <p class="mt-3" style="color:#64748b !important;">Create a design first, then it will appear here with its status and staff response.</p>
          <a href="{{ path('app_customization_new') }}" class="btn-primary mt-6">Create Custom Design</a>
        </div>
      {% endfor %}
    </div>
  </div>
</section>
{% endblock %}
