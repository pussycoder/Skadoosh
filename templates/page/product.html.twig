{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - SKADOOSH{% endblock %}

{% block stylesheets %}
<style>
  body {
    background-image: url('{{ asset('Pattern.png') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  .pd-shell {
    background: rgba(255, 255, 255, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.28);
    box-shadow: 0 24px 70px rgba(15, 23, 42, 0.10);
  }
  .pd-gallery-card {
    background: linear-gradient(180deg, rgba(248,250,252,0.96), rgba(255,255,255,0.98));
    border: 1px solid rgba(148, 163, 184, 0.22);
  }
  .pd-info-card {
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(148, 163, 184, 0.25);
    box-shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
  }
  .swatch {
    width: 2rem;
    height: 2rem;
    border-radius: 999px;
    border: 1px solid rgba(148,163,184,0.65);
    box-shadow: inset 0 0 0 3px rgba(255,255,255,0.88);
    transition: transform 160ms ease, outline-color 160ms ease;
  }
  .swatch:hover {
    transform: translateY(-1px);
  }
  .swatch[aria-checked="true"] {
    outline: 2px solid #111827;
    outline-offset: 3px;
  }
  .size-btn {
    min-width: 3rem;
    height: 3rem;
  }
  .size-btn[aria-pressed="true"] {
    border-color: #111827 !important;
    background: #111827 !important;
    color: #ffffff !important;
  }
  .pd-primary-btn,
  .pd-primary-btn * {
    color: #ffffff !important;
  }
  .pd-detail-row {
    border-top: 1px solid rgba(148, 163, 184, 0.24);
  }
</style>
{% endblock %}

{% block body %}
{% set selectedColor = (colors|filter(c => c.code == colorCode)|first) %}
{% set selectedSize = (sizes|filter(s => s.code == sizeCode)|first) %}
{% set imageUrl = selectedColor and selectedColor.imageUrl is defined ? selectedColor.imageUrl : (product.image ? asset('uploads/images/' ~ product.image) : '') %}
{% set productUrl = path('app_shop_product', {'id': product.id}) %}
{% set categoryName = product.category ? product.category.name : 'Uncategorized' %}
{% set isAccessories = product.category and (product.category.name|lower == 'accessories') %}

<section class="max-w-7xl mx-auto px-4 sm:px-6 py-8 sm:py-12">
  <nav class="text-xs sm:text-sm mb-6" style="color:#64748b;">
    <a href="{{ path('app_shop') }}" class="underline font-semibold" style="color:#7a0000 !important;">Shop</a>
    <span aria-hidden="true"> / </span>
    <span style="color:#0f172a !important;">{{ product.name }}</span>
  </nav>

  <div class="pd-shell rounded-[2rem] p-4 sm:p-6 lg:p-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10">
      <section class="lg:col-span-7">
        <div class="pd-gallery-card rounded-[1.75rem] overflow-hidden">
          <div class="relative aspect-[4/5] sm:aspect-[5/4] lg:aspect-[4/5] bg-white flex items-center justify-center">
            {% if imageUrl %}
              <img src="{{ imageUrl }}" alt="{{ product.name }}" class="w-full h-full object-contain p-6 sm:p-10">
            {% else %}
              <div class="w-full h-full flex items-center justify-center text-sm" style="color:#64748b;">No image</div>
            {% endif %}
            <span class="absolute left-4 top-4 rounded-full px-3 py-1 text-[0.68rem] font-extrabold uppercase tracking-[0.18em]" style="background:#111827; color:#ffffff !important;">In stock</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 sm:gap-4 mt-4">
          {% for i in 1..3 %}
            <button type="button" class="pd-gallery-card rounded-2xl overflow-hidden aspect-square bg-white">
              {% if imageUrl %}
                <img src="{{ imageUrl }}" alt="{{ product.name }} thumbnail {{ i }}" class="w-full h-full object-contain p-3 opacity-90">
              {% else %}
                <span class="text-xs" style="color:#64748b;">No image</span>
              {% endif %}
            </button>
          {% endfor %}
        </div>
      </section>

      <aside class="lg:col-span-5">
        <div class="pd-info-card rounded-[1.75rem] p-5 sm:p-7 lg:sticky lg:top-28">
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-[0.24em]" style="color:#7a0000 !important;">{{ categoryName }}</p>
              <h1 class="mt-2 text-3xl sm:text-4xl font-extrabold leading-tight" style="color:#0f172a !important;">{{ product.name }}</h1>
            </div>
            <button
              type="button"
              class="shrink-0 rounded-full border border-slate-200 bg-white w-11 h-11 inline-flex items-center justify-center"
              data-favorite-product
              data-id="{{ product.id }}"
              data-name="{{ product.name|e('html_attr') }}"
              data-price="{{ product.price }}"
              data-image="{{ imageUrl }}"
              data-url="{{ productUrl }}"
              aria-label="Save {{ product.name }} to favorites"
            >
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 20.5S4.5 16.1 4.5 9.9A4.1 4.1 0 0 1 12 7.6a4.1 4.1 0 0 1 7.5 2.3c0 6.2-7.5 10.6-7.5 10.6Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
            </button>
          </div>

          <div class="mt-5 flex items-end justify-between gap-4">
            <p class="text-2xl font-extrabold" style="color:#7a0000 !important;">₱{{ product.price|number_format(2, '.', ',') }}</p>
            <p class="text-xs font-bold rounded-full px-3 py-1" style="background:rgba(122,0,0,0.08); color:#7a0000 !important;">Ready to ship</p>
          </div>

          {% if not isAccessories %}
            <div class="pd-detail-row mt-7 pt-6">
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-sm font-extrabold" style="color:#0f172a !important;">Color</h2>
                <p class="text-xs font-semibold" style="color:#64748b !important;">{{ selectedColor ? selectedColor.name : colorCode }}</p>
              </div>
              <div class="mt-4 flex flex-wrap gap-3" role="radiogroup" aria-label="Select color">
                {% for c in colors %}
                  <a
                    href="{{ path('app_shop_product', {'id': product.id}) ~ '?colorCode=' ~ c.code ~ '&sizeCode=' ~ sizeCode }}"
                    class="swatch"
                    style="{% if c.imageUrl is defined %}background-image:url('{{ c.imageUrl }}'); background-size:cover; background-position:center;{% else %}background: {{ c.hex }};{% endif %}"
                    role="radio"
                    aria-checked="{{ c.code == colorCode ? 'true' : 'false' }}"
                    aria-label="{{ c.name }}"
                    title="{{ c.name }}"
                  ></a>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          {% if not isAccessories %}
            <div class="pd-detail-row mt-6 pt-6">
              <div class="flex items-center justify-between gap-4">
                <h2 class="text-sm font-extrabold" style="color:#0f172a !important;">Size</h2>
                <a href="{{ path('app_page_contact') }}#sizing" class="text-xs font-bold underline" style="color:#7a0000 !important;">Size help</a>
              </div>
              <div class="mt-4 grid grid-cols-3 sm:grid-cols-6 gap-2" role="group" aria-label="Select size">
                {% for s in sizes %}
                  <a
                    href="{{ path('app_shop_product', {'id': product.id}) ~ '?colorCode=' ~ colorCode ~ '&sizeCode=' ~ s.code }}"
                    class="size-btn inline-flex items-center justify-center rounded-xl border border-slate-300 bg-white text-sm font-extrabold"
                    style="color:#0f172a !important; text-decoration:none;"
                    aria-pressed="{{ s.code == sizeCode ? 'true' : 'false' }}"
                  >{{ s.label }}</a>
                {% endfor %}
              </div>
            </div>
          {% endif %}

          <div class="mt-7 grid gap-3">
            <button
              type="button"
              class="pd-primary-btn w-full rounded-xl py-4 font-extrabold uppercase tracking-[0.16em] text-xs"
              style="background:#111827; color:#ffffff !important;"
              data-add-cart
              data-redirect="cart"
              data-id="{{ product.id }}"
              data-name="{{ product.name|e('html_attr') }}"
              data-price="{{ product.price }}"
              data-image="{{ imageUrl }}"
              data-url="{{ productUrl }}"
              data-category="{{ categoryName|e('html_attr') }}"
              data-color="{{ selectedColor ? selectedColor.name|e('html_attr') : colorCode }}"
              data-size="{{ selectedSize ? selectedSize.label|e('html_attr') : 'One size' }}"
            >Add to cart</button>
            <a href="{{ path('app_customization_new') }}?type={{ isAccessories ? 'accessories' : 'tshirt' }}" class="w-full rounded-xl py-3.5 font-extrabold border border-slate-300 bg-white inline-flex items-center justify-center" style="text-decoration:none;">
              Customize this style
            </a>
          </div>

          <div class="mt-6 grid grid-cols-3 gap-2 text-center">
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <strong class="block text-xs">Secure</strong>
              <span class="text-[0.68rem]" style="color:#64748b !important;">Demo cart</span>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <strong class="block text-xs">Fast</strong>
              <span class="text-[0.68rem]" style="color:#64748b !important;">Browse flow</span>
            </div>
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-3">
              <strong class="block text-xs">Custom</strong>
              <span class="text-[0.68rem]" style="color:#64748b !important;">Requests</span>
            </div>
          </div>

          <div class="pd-detail-row mt-6 pt-6">
            <h2 class="text-sm font-extrabold mb-2" style="color:#0f172a !important;">Description</h2>
            <p class="text-sm leading-relaxed" style="color:#334155 !important;">{{ product.description|striptags }}</p>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
{% endblock %}
