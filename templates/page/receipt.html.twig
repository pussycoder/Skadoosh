{% extends 'base.html.twig' %}

{% block title %}Receipt #{{ order.id }} - SKADOOSH{% endblock %}

{% block stylesheets %}
<style>
  body {
    background-image: url('{{ asset('Pattern.png') }}');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
  }
  .receipt-hero {
    background: linear-gradient(135deg, #080d18 0%, #1f2937 55%, #080d18 100%);
  }
  .receipt-card {
    background: rgba(255,255,255,0.96);
    border: 1px solid rgba(148,163,184,0.35);
    box-shadow: 0 24px 70px rgba(15,23,42,0.10);
  }
</style>
{% endblock %}

{% block body %}
<section class="pb-16">
  <header class="receipt-hero">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
      <p class="text-xs font-extrabold uppercase tracking-[0.28em] mb-3" style="color:rgba(226,232,240,0.86) !important;">Receipt</p>
      <h1 class="text-4xl sm:text-5xl font-extrabold" style="color:#ffffff !important;">Order #{{ order.id }} received</h1>
      <p class="mt-4 max-w-2xl text-base leading-relaxed" style="color:rgba(226,232,240,0.88) !important;">No payment gateway was used. Your order is now pending and visible to staff/admin.</p>
    </div>
  </header>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 pt-10">
    <article class="receipt-card rounded-3xl p-5 sm:p-8">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-5 border-b border-slate-200 pb-6">
        <div>
          <h2 class="text-2xl font-extrabold">Thank you, {{ order.customerName }}</h2>
          <p class="mt-2 text-sm" style="color:#64748b !important;">Placed {{ order.createdAt ? order.createdAt|date('M d, Y g:i A') : '' }}</p>
        </div>
        <span class="inline-flex rounded-full px-4 py-2 text-sm font-extrabold" style="background:rgba(122,0,0,0.08); color:#7a0000 !important;">{{ order.status }}</span>
      </div>

      <dl class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-5 text-sm">
        <div>
          <dt class="font-bold">Email</dt>
          <dd class="mt-1" style="color:#475569 !important;">{{ order.customerEmail }}</dd>
        </div>
        <div>
          <dt class="font-bold">Shipping address</dt>
          <dd class="mt-1" style="color:#475569 !important;">{{ order.shippingAddress ?: 'No shipping address provided' }}</dd>
        </div>
      </dl>

      <div class="mt-7 rounded-2xl border border-slate-200 bg-white p-5">
        <h3 class="font-extrabold">Items</h3>
        <p class="mt-3 text-sm leading-relaxed whitespace-pre-line" style="color:#334155 !important;">{{ order.orderedProducts }}</p>
      </div>

      <div class="mt-6 flex items-center justify-between gap-4 border-t border-slate-200 pt-5">
        <span class="font-extrabold">Total</span>
        <span class="text-2xl font-extrabold" style="color:#7a0000 !important;">₱{{ order.totalPrice|number_format(2, '.', ',') }}</span>
      </div>

      <div class="mt-8 flex flex-col sm:flex-row gap-3">
        <a href="{{ path('app_my_orders') }}" class="btn-primary">View My Orders</a>
        <a href="{{ path('app_shop') }}" class="btn-secondary">Continue shopping</a>
      </div>
    </article>
  </div>
</section>
{% endblock %}
